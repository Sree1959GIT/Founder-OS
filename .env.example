# FounderOS configuration. Copy to `.env` (git-ignored) and edit. Every key is optional; defaults are shown.

# --- Workspace and storage --------------------------------------------------
# Letters, digits, '-' and '_' only. Storage lives under <DATA_DIR>/<WORKSPACE_ID> and <VAULT_PATH>/<WORKSPACE_ID>.
WORKSPACE_ID=default
# Relative paths are resolved against the repository root.
DATA_DIR=data
VAULT_PATH=vault

# --- Financial data -----------------------------------------------------------
# Load the Northwind demo data into an empty workspace at startup. Set to false once you use your own files.
AUTO_LOAD_SAMPLE_DATA=true
SAMPLE_DATA_DIR=sample_data
# Largest CSV/XLSX upload accepted, in MB.
MAX_UPLOAD_MB=20

# --- Local LLM (Ollama native app) -----------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Vector store (Qdrant in Docker) ---------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- Vault and search --------------------------------------------------------
# Copy the Northwind sample notes into an empty vault at startup.
AUTO_LOAD_SAMPLE_VAULT=true
# auto = Qdrant when it answers at startup, else vectors in memory | qdrant | memory
VECTOR_STORE=auto
# ollama = OLLAMA_EMBED_MODEL above | fake = offline hashing embedder (no semantic quality; tests/demos only)
EMBED_PROVIDER=ollama
# tiktoken (cl100k_base; downloads its vocabulary once, falls back to approx offline) | approx
TOKENIZER=tiktoken
# Re-index when files in the vault change (Obsidian, Notepad). Polling helps on network drives.
VAULT_WATCH=true
VAULT_WATCH_POLLING=false

# --- Deep-work agents (risk, memo, scout) ----------------------------------
# One of: claude_sdk | anthropic | gemini | ollama. Falls back to ollama when credentials are missing.
DEEP_PROVIDER=ollama
# Nothing is sent to a cloud model unless this is true (PRD R2).
CLOUD_ALLOWED=false

# Claude via the Claude Agent SDK on your subscription (personal use). Create with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
# Claude via the Anthropic API (for the future commercial product).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Google Gemini (google-genai SDK).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Display -----------------------------------------------------------------
# ISO 4217 code, e.g. USD or INR.
CURRENCY=USD

# --- Optional ----------------------------------------------------------------
# LOG_LEVEL=INFO   # TRACE | DEBUG | INFO | WARNING | ERROR
# HEALTH_PROBE_TIMEOUT_S=2.0
