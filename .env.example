# FounderOS configuration. Copy to `.env` (git-ignored) and edit. Every key is optional; defaults are shown.

# --- Workspace and storage --------------------------------------------------
# Letters, digits, '-' and '_' only. Storage lives under <DATA_DIR>/<WORKSPACE_ID> and <VAULT_PATH>/<WORKSPACE_ID>.
WORKSPACE_ID=default
# Relative paths are resolved against the repository root.
DATA_DIR=data
VAULT_PATH=vault

# --- Financial data -----------------------------------------------------------
# Load the Northwind demo data into an empty workspace at startup. Set to false once you use your own files.
AUTO_LOAD_SAMPLE_DATA=true
SAMPLE_DATA_DIR=sample_data
# Largest CSV/XLSX upload accepted, in MB.
MAX_UPLOAD_MB=20

# --- Local LLM (Ollama) -------------------------------------------------------
# An external service: the native Ollama app or a Docker container (e.g. one shared with n8n). setup.bat finds it
# over HTTP; without the ollama command it prints "docker exec ollama ollama pull <model>" for missing models.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Qwen3 "thinking" (reasoning before answering). Off = fast replies and clean JSON / tool calls.
OLLAMA_THINK=false
# How long Ollama keeps the chat model in VRAM after a call (empty = Ollama's default, 5m).
OLLAMA_KEEP_ALIVE=30m
# Context window in tokens (larger uses more VRAM).
OLLAMA_NUM_CTX=8192
# Load the chat model in the background at startup. A cold load from a slow disk can take minutes; calls also
# load it first when Ollama has unloaded it.
OLLAMA_WARMUP=true
# ollama | fake (scripted offline replies; agents then answer from rules)
LLM_PROVIDER=ollama
LLM_TIMEOUT_S=180

# --- Agents --------------------------------------------------------------------
# Who approves the Planner's team before it runs: always | cloud_only | never
TEAM_APPROVAL=cloud_only
TEAM_APPROVAL_TIMEOUT_S=300
# Agent instances that may run at once (extra ones queue).
MAX_LOCAL_AGENTS=2
MAX_CLOUD_AGENTS=6
# Tool-calling rounds per agent before it must answer.
AGENT_MAX_STEPS=4
# Decision model for fast typed choices (intent routing): llm | fake. Laya / Jev arrive in M3c.
DECISION_PROVIDER=llm
DECISION_MIN_CONFIDENCE=0.75
# Decision model: llm (default) | fake | laya | jev. The default stays llm until the bake-off says otherwise and you
# approve. Below the confidence, or on any failure, laya and jev fall back to the LLM.
# laya needs the optional package (see scripts/finetune_laya.py) and a fine-tuned checkpoint to be useful.
LAYA_CHECKPOINT=
LAYA_DEVICE=
# jev is paid ($0.042 per million input tokens, read 2026-11-05). It receives only non-sensitive routing state.
JEV_API_KEY=
JEV_MODEL=jev-latest

# --- Conversation lane (responsive while agents run) ---------------------------
# A small local model for quick replies during a run, e.g. qwen3:4b. Empty: templates only, no model call.
FAST_LANE_MODEL=
# Slower than this and the lane answers from a template (a shared GPU can be busy with the agents).
FAST_LANE_TIMEOUT_S=4
# true: no narration events unless asked; questions are still answered.
CONVERSATION_QUIET=false

# --- Vector store (Qdrant in Docker) ---------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- Vault and search --------------------------------------------------------
# Copy the Northwind sample notes into an empty vault at startup.
AUTO_LOAD_SAMPLE_VAULT=true
# auto = Qdrant when it answers at startup, else vectors in memory | qdrant | memory
VECTOR_STORE=auto
# ollama = OLLAMA_EMBED_MODEL above | fake = offline hashing embedder (no semantic quality; tests/demos only)
EMBED_PROVIDER=ollama
# tiktoken (cl100k_base; downloads its vocabulary once, falls back to approx offline) | approx
TOKENIZER=tiktoken
# Re-index when files in the vault change (Obsidian, Notepad). Polling helps on network drives.
VAULT_WATCH=true
VAULT_WATCH_POLLING=false

# --- Cloud models (off by default) --------------------------------------------
# Nothing is sent to a cloud model unless this is true (PRD R2). Every cloud payload goes through the privacy filter,
# teams with a cloud agent wait for your approval, and any failure falls back to Ollama.
CLOUD_ALLOWED=false
# Default for cloud-allowed agents: anthropic | gemini | openai | openai_compatible | ollama
DEEP_PROVIDER=ollama
# Per agent type, JSON, "provider" or "provider:model". Example:
# AGENT_MODELS={"memo_writer": "anthropic:claude-opus-5-5", "market_scout": "gemini", "regulatory_tax": "openai"}
AGENT_MODELS={}
# At or over this month's estimated spend, cloud agents use Ollama. 0 means no cloud calls at all.
CLOUD_MONTHLY_CAP_USD=25
# USD per million tokens [input, output], added to the built-in table. A model with no known price is not called.
# LLM_PRICES={"deepseek-chat": [0.3, 1.2]}
LLM_PRICES={}

# Claude: an API key only (console.anthropic.com). A Claude Free, Pro or Max subscription cannot be used here.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Google Gemini: an AI Studio key, or a Vertex AI key with GEMINI_BACKEND=vertex.
GEMINI_BACKEND=ai_studio
GEMINI_API_KEY=
VERTEX_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra

# Any endpoint that speaks OpenAI's API, e.g. https://openrouter.ai/api/v1 or https://api.deepseek.com/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# --- Display -----------------------------------------------------------------
# ISO 4217 code, e.g. USD or INR.
CURRENCY=USD

# --- Optional ----------------------------------------------------------------
# LOG_LEVEL=INFO   # TRACE | DEBUG | INFO | WARNING | ERROR
# HEALTH_PROBE_TIMEOUT_S=2.0
