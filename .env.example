# FounderOS configuration. Copy to `.env` (git-ignored) and edit. Every key is optional; defaults are shown.

# --- Workspace and storage --------------------------------------------------
# Letters, digits, '-' and '_' only. Storage lives under <DATA_DIR>/<WORKSPACE_ID> and <VAULT_PATH>/<WORKSPACE_ID>.
WORKSPACE_ID=default
# Relative paths are resolved against the repository root.
DATA_DIR=data
VAULT_PATH=vault

# --- Local LLM (Ollama native app) -----------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Vector store (Qdrant in Docker) ---------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- Deep-work agents (risk, memo, scout) ----------------------------------
# One of: claude_sdk | anthropic | gemini | ollama. Falls back to ollama when credentials are missing.
DEEP_PROVIDER=ollama
# Nothing is sent to a cloud model unless this is true (PRD R2).
CLOUD_ALLOWED=false

# Claude via the Claude Agent SDK on your subscription (personal use). Create with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
# Claude via the Anthropic API (for the future commercial product).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Google Gemini (google-genai SDK).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Display -----------------------------------------------------------------
# ISO 4217 code, e.g. USD or INR.
CURRENCY=USD

# --- Optional ----------------------------------------------------------------
# LOG_LEVEL=INFO
# HEALTH_PROBE_TIMEOUT_S=2.0
